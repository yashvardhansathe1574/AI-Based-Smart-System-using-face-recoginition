def _build_report(from_date, to_date):
    with get_db() as conn:
        students = conn.execute("SELECT * FROM students ORDER BY student_id").fetchall()
        rows = conn.execute(
            "SELECT * FROM attendance WHERE attendance_date >= ? AND attendance_date <= ?",
            (from_date, to_date),
        ).fetchall()
    # a session is one (date, period) slot that actually happened
    total_sessions = len({(r["attendance_date"], r["period"]) for r in rows})
    present_by_student = {}
    for r in rows:
        present_by_student[r["student_id"]] = present_by_student.get(r["student_id"], 0) + 1
    per_student = []
    for s in students:
        present = present_by_student.get(s["student_id"], 0)
        per_student.append(
            {
                "student_id": s["student_id"],
                "name": s["name"],
                "class_name": s["class_name"],
                "present_days": present,
                "total_days": total_sessions,
                "percentage": round(present / total_sessions * 100, 1) if total_sessions else 0.0,
            }
        )
    present_count = len(rows)
    total_slots = len(students) * total_sessions
    defaulters = sorted(
        [r for r in per_student if r["percentage"] < DEFAULTER_THRESHOLD],
        key=lambda r: r["percentage"],
    )
    return {
        "from_date": from_date,
        "to_date": to_date,
        "total_students": len(students),
        "total_days": total_sessions,
        "present_count": present_count,
        "absent_count": max(total_slots - present_count, 0),
        "attendance_percentage": round(present_count / total_slots * 100, 1) if total_slots else 0.0,
        "defaulter_threshold": DEFAULTER_THRESHOLD,
        "per_student": per_student,
        "defaulters": defaulters,
    }


