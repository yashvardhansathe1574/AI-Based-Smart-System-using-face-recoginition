            )
            print("seeded admin user 'admin' (password hashed with PBKDF2-SHA256)")
        if conn.execute("SELECT COUNT(*) FROM students").fetchone()[0] == 0:
            for student_id, name, class_name, email in SAMPLE_STUDENTS:
                conn.execute(
                    "INSERT INTO students (id, student_id, name, class_name, email, face_encoding, created_at)"
                    " VALUES (?, ?, ?, ?, ?, NULL, ?)",
