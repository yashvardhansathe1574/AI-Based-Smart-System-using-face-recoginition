        f"AI Smart Attendance System - Defaulter List (below {data['defaulter_threshold']}%)"
        if defaulters_only
        else "AI Smart Attendance System - Attendance Report"
    )

    buf = io.StringIO()
    writer = csv.writer(buf)
    writer.writerow([title])
    writer.writerow(["From", data["from_date"], "To", data["to_date"]])
    writer.writerow(["Sessions (date x period)", data["total_days"]])
    writer.writerow([])
    writer.writerow(
        ["Student ID", "Name", "Class", "Sessions", "Periods Attended", "Missed", "Attendance %"]
    )
    for r in rows:
        writer.writerow(
            [r["student_id"], r["name"], r["class_name"], r["total_days"], r["present_days"],
             r["total_days"] - r["present_days"], f"{r['percentage']}%"]
        )
    writer.writerow([])
    writer.writerow(["Total Students", data["total_students"]])
    writer.writerow(["Attendance Records (present)", data["present_count"]])
    writer.writerow(["Absent (missed periods)", data["absent_count"]])
    writer.writerow(["Overall Attendance %", f"{data['attendance_percentage']}%"])
    writer.writerow([f"Defaulters (<{data['defaulter_threshold']}%)", len(data["defaulters"])])
    buf.seek(0)
    prefix = "defaulter_list" if defaulters_only else "attendance_report"
    return send_file(
        io.BytesIO(buf.getvalue().encode("utf-8")),
        mimetype="text/csv",
        as_attachment=True,
        download_name=f"{prefix}_{from_date}_to_{to_date}.csv",
    )


if __name__ == "__main__":
    init_db()
    app.run(host="0.0.0.0", port=PORT, debug=False)
