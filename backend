                )
            print(f"seeded {len(SAMPLE_STUDENTS)} sample students (no faces, no attendance)")


def login_required(fn):
    @wraps(fn)
    def wrapper(*args, **kwargs):
        if "user_id" not in session:
            return jsonify({"detail": "Not authenticated"}), 401
        return fn(*args, **kwargs)

    return wrapper


def stored_encodings(row) -> list:
    """All encodings for a student (multi-angle), tolerating the legacy single column."""
    raw = row["face_encodings"] if "face_encodings" in row.keys() else None
    if raw:
        try:
            samples = json.loads(raw)
            if isinstance(samples, list) and samples:
                return samples
        except (TypeError, ValueError):
            pass
    if row["face_encoding"]:
        return [json.loads(row["face_encoding"])]
    return []


def student_out(row) -> dict:
    samples = stored_encodings(row)
    return {
        "id": row["id"],
        "student_id": row["student_id"],
        "name": row["name"],
        "class_name": row["class_name"],
        "email": row["email"],
        "face_registered": len(samples) > 0,
        "face_samples": len(samples),
        "created_at": row["created_at"],
    }


