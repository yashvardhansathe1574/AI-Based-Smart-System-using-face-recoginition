def _build_uniform_lut() -> np.ndarray:    """Map each 8-bit LBP code to a uniform-pattern bin (58 uniform + 1 catch-all)."""    lut = np.full(256, UNIFORM_BINS - 1, dtype=np.uint8)    next_bin = 0    for value in range(256):        bits = [(value >> i) & 1 for i in range(8)]        transitions = sum(bits[i] != bits[(i + 1) % 8] for i in range(8))        if transitions <= 2:  # "uniform": at most two 0<->1 changes around the circle            lut[value] = next_bin            next_bin += 1    return lut

