@login_required
def face_recognize():
    body = request.get_json(force=True, silent=True) or {}
    period = int(body.get("period") or 1)
    subject = str(body.get("subject") or "")[:60]
    if not 1 <= period <= PERIOD_COUNT:
        return jsonify({"detail": f"period must be between 1 and {PERIOD_COUNT}"}), 422
    try:
        probe = encoding_from_dataurl(str(body.get("image", "")))
    except ValueError as exc:
        return jsonify(
            {"recognized": False, "message": str(exc), "similarity": None,
             "threshold": MATCH_THRESHOLD, "student": None, "attendance_status": None,
             "period": period, "subject": subject, "matched_sample": None}
        )

    # best score across every student AND every stored angle of that student
    best_sim, best_row, best_index = 0.0, None, 0
    with get_db() as conn:
        for row in conn.execute("SELECT * FROM students").fetchall():
            for index, sample in enumerate(stored_encodings(row), start=1):
                sim = cosine_similarity(probe, sample)
                if sim > best_sim:
                    best_sim, best_row, best_index = sim, row, index

    if best_row is None or best_sim < MATCH_THRESHOLD:
        return jsonify(
            {
                "recognized": False,
                "message": "Unknown face — no registered match found",
                "similarity": round(best_sim * 100, 1) if best_row else None,
                "threshold": MATCH_THRESHOLD,
                "student": None,
                "attendance_status": None,
                "period": period,
                "subject": subject,
                "matched_sample": None,
            }
        )

    student = {
        "student_id": best_row["student_id"],
        "name": best_row["name"],
        "class_name": best_row["class_name"],
    }
    similarity = round(best_sim * 100, 1)
    today = now_ist().strftime("%Y-%m-%d")

    def payload(message, status):
        return jsonify(
            {"recognized": True, "message": message, "similarity": similarity,
             "threshold": MATCH_THRESHOLD, "student": student, "attendance_status": status,
             "period": period, "subject": subject, "matched_sample": best_index}
        )

    with get_db() as conn:
        existing = conn.execute(
            "SELECT 1 FROM attendance WHERE student_id = ? AND attendance_date = ? AND period = ?",
            (student["student_id"], today, period),
        ).fetchone()
        if existing:
            return payload(f"Already marked for Period {period} today", "already_marked")
        try:
            conn.execute(
                "INSERT INTO attendance (id, student_id, attendance_date, attendance_time, period,"
                " subject, status) VALUES (?, ?, ?, ?, ?, ?, 'Present')",
                (str(uuid.uuid4()), student["student_id"], today,
                 now_ist().strftime("%H:%M:%S"), period, subject),
            )
        except sqlite3.IntegrityError:
            return payload(f"Already marked for Period {period} today", "already_marked")
    return payload(f"Attendance marked for Period {period}", "marked")


